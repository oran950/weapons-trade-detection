# =============================================================================
# WEAPONS TRADE DETECTION SYSTEM - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# NEVER commit your real .env file to git.
# =============================================================================

# -----------------------------------------------------------------------------
# REDDIT API (Required for Reddit collection)
# Get your credentials at: https://www.reddit.com/prefs/apps
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=WeaponsDetection/2.4 (Academic Research; by /u/your_reddit_username)

# Optional Reddit tuning
REDDIT_RATE_LIMIT_DELAY=2
REDDIT_MAX_POSTS_PER_REQUEST=50

# -----------------------------------------------------------------------------
# TELEGRAM BOT API (Optional)
# Create a bot via @BotFather on Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# -----------------------------------------------------------------------------
# TELEGRAM USER API (Required for Telegram channel collection)
# Get your credentials at: https://my.telegram.org
# After setting these, run: cd backend && python scripts/telegram_auth.py
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_NAME=weapons_detection_session
# Folder containing the .session file (optional)
# TELEGRAM_SESSION_DIR=/absolute/path/to/folder

# -----------------------------------------------------------------------------
# OLLAMA LLM
# Local: http://localhost:11434 — Docker Compose injects http://ollama:11434
# Do not set OLLAMA_BASE in .env when using Docker (compose sets it).
# -----------------------------------------------------------------------------
# OLLAMA_BASE=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llava:7b
# When true, collection refuses to start if Ollama is down or models are missing
OLLAMA_MANDATORY=true
