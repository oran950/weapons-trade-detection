# =============================================================================
# WEAPONS TRADE DETECTION SYSTEM - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# REDDIT API (Required for Reddit collection)
# Get your credentials at: https://www.reddit.com/prefs/apps
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=WeaponsDetection/2.4 (Academic Research)

# -----------------------------------------------------------------------------
# TELEGRAM API (Optional - for Telegram collection)
# Get your credentials at: https://my.telegram.org
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=weapons_detection_session
# Folder containing the .session file (optional). Auth creates it in cwd if unset.
# TELEGRAM_SESSION_DIR=/absolute/path/to/folder

# -----------------------------------------------------------------------------
# OLLAMA LLM (Auto-configured when using Docker)
# -----------------------------------------------------------------------------
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b
# When true, collection and SSE refuse to start if Ollama is down or required models are missing.
OLLAMA_MANDATORY=true

# -----------------------------------------------------------------------------
# CORS (browser frontends allowed to call this API)
# Comma-separated. Add your Cloudflare Pages URL after deploy, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://your-app.pages.dev
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
